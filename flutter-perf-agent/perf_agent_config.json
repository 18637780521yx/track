{
  "bridgeHost": "127.0.0.1",
  "bridgePort": 19288,
  "waitStableMs": 500,
  "postActionSettleMs": 400,
  "navigationWaitMs": 800,
  "maxRetries": 2,
  "retryDelayMs": 300,
  "captureScreenshots": false,
  "debugLog": true,
  "reportsDir": "reports",
  "enableNetworkCapture": true,
  "enableWidgetAntiPattern": true,
  "devtoolsSampling": {
    "enabled": false,
    "http": false,
    "logging": false,
    "clearCpuEachStep": false,
    "cpuTopN": 10,
    "artifactRawTraces": false
  },
  "debugger": {
    "pauseAllowed": false
  },
  "thresholds": {
    "maxFrameCostMs": 16,
    "memoryIncreaseWarningMB": 5,
    "heapIncreaseWarningMB": 8,
    "slowRequestMs": 300,
    "ttffWarningMs": 1500
  },
  "transition": {
    "leakTrackEnabled": true,
    "transitionSettleMs": 1500,
    "leakConfirmRounds": 2,
    "leakRssRetainMb": 5,
    "sleuthBindEnabled": true,
    "alertOnWeakRef": true,
    "requireMultiRound": false,
    "alertOnSleuthOnly": true,
    "alertOnRssRetain": true,
    "leakVmDeepProbe": false
  },
  "coldStart": {
    "relaunch": false,
    "appPath": "example_app/build/macos/Build/Products/Debug/example_app.app",
    "maxWaitMs": 45000,
    "ttffWarningMs": 1500
  }
}
